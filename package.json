{
  "name": "ware-kds",
  "private": true,
  "version": "0.1.0",
  "description": "M.O.B.I.™ Kitchen Display System — mini-app táctil para estaciones de cocina (SPEC-WKDS1)",
  "author": "M.O.B.I.™",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "api:gen": "openapi-typescript ../wared/api/openapi.yaml -o src/lib/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  }
}
